rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function image() { return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /profile_images/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if owner(uid) && image();
      allow delete: if owner(uid);
    }
    match /event_images/{uid}/{eventId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if owner(uid) && image();
      allow delete: if owner(uid);
    }
  }
}
